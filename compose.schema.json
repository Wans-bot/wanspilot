{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "compose.yml (minimal offline schema for wanspilot)",
  "type": "object",
  "required": ["services"],
  "properties": {
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/service" }
    }
  },
  "definitions": {
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "type": "string" },
        "container_name": { "type": "string" },
        "restart": { "enum": ["no", "always", "on-failure", "unless-stopped"] },
        "network_mode": { "type": "string" },
        "ports": { "type": "array", "items": { "type": ["string", "number"] } },
        "environment": {
          "oneOf": [
            { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "volumes": { "type": "array", "items": { "type": "string" } },
        "healthcheck": { "type": "object", "additionalProperties": true },
        "extra_hosts": { "type": "array", "items": { "type": "string" } },
        "labels": {
          "oneOf": [
            { "type": "object" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    }
  }
}
